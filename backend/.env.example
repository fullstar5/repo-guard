# Runtime
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=CodeGuard AI

# PostgreSQL
NEON_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# GitHub OAuth and webhook
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GITHUB_OAUTH_SCOPE="read:user user:email repo"

# Browser session
OAUTH_STATE_COOKIE_NAME=codeguard_oauth_state
ACCESS_TOKEN_COOKIE_NAME=codeguard_access_token
COOKIE_SECURE=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter
OPEN_ROUTER_API_KEY=replace-with-openrouter-api-key
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_READ_TIMEOUT=120

# Review pipeline
REVIEW_MAX_COMBINED_CHARS=120000
REVIEW_MAX_PATCH_CHARS=20000
REVIEW_MAX_COMBINED_FILES=30
REVIEW_MAX_COMBINED_CHANGES=1000
REVIEW_RETRY_ATTEMPTS=3

# RabbitMQ and Celery
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
CELERY_TASK_RETRY_BACKOFF_MAX=300
CELERY_TASK_SOFT_TIME_LIMIT=660
CELERY_TASK_TIME_LIMIT=720
CELERY_TASK_RECLAIM_INTERVAL_SECONDS=600
REVIEW_JOB_STALE_PROCESSING_SECONDS=900
