# Runtime
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
APP_NAME=CodeGuard AI

# PostgreSQL
NEON_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Upstash Redis REST
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Distributed rate limiting
# Keep false for offline local work; production requires true.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_TIMEOUT_SECONDS=1.5
# Direct Northflank traffic normally uses 1. Increase after verifying an
# additional trusted proxy such as a Vercel rewrite in X-Forwarded-For.
RATE_LIMIT_TRUSTED_PROXY_HOPS=1
RATE_LIMIT_OAUTH_REQUESTS=20
RATE_LIMIT_OAUTH_WINDOW_SECONDS=600
RATE_LIMIT_SYNC_USER_REQUESTS=30
RATE_LIMIT_SYNC_USER_WINDOW_SECONDS=600
RATE_LIMIT_SYNC_OBJECT_REQUESTS=6
RATE_LIMIT_SYNC_OBJECT_WINDOW_SECONDS=60
RATE_LIMIT_REVIEW_USER_REQUESTS=5
RATE_LIMIT_REVIEW_USER_WINDOW_SECONDS=3600
RATE_LIMIT_REVIEW_OBJECT_REQUESTS=2
RATE_LIMIT_REVIEW_OBJECT_WINDOW_SECONDS=600

# GitHub OAuth and webhook
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
GITHUB_OAUTH_SCOPE="read:user user:email repo"

# Browser session
OAUTH_STATE_COOKIE_NAME=codeguard_oauth_state
ACCESS_TOKEN_COOKIE_NAME=codeguard_access_token
COOKIE_SECURE=false
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter
OPEN_ROUTER_API_KEY=replace-with-openrouter-api-key
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1
OPEN_ROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_READ_TIMEOUT=7200

# Review pipeline
REVIEW_PACK_MAX_CHARS=8000
REVIEW_CONTEXT_LINES=40
REVIEW_RETRY_ATTEMPTS=3
# Original combined/chunk limits. Unused after GitHub window packing.
# REVIEW_MAX_COMBINED_CHARS=120000
# REVIEW_MAX_PATCH_CHARS=20000
# REVIEW_MAX_COMBINED_FILES=30
# REVIEW_MAX_COMBINED_CHANGES=1000

# RabbitMQ and Celery
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF_SECONDS=5
CELERY_TASK_RETRY_BACKOFF_MAX=300
CELERY_TASK_SOFT_TIME_LIMIT=3600
CELERY_TASK_TIME_LIMIT=4200
CELERY_TASK_RECLAIM_INTERVAL_SECONDS=21600
REVIEW_JOB_STALE_PROCESSING_SECONDS=10800
